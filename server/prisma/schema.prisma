datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  phone     String?  @unique
  password  String
  name      String
  address   String?
  pincode   String?
  state     String?
  isVerified Boolean @default(false)
  orders    Order[]
  cartItems CartItem[]
  createdAt DateTime @default(now())
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String?  @unique
  phone     String?  @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CartItem {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  productId Int
  quantity  Int
  updatedAt DateTime @updatedAt
}

model Order {
  id                Int         @id @default(autoincrement())
  user              User        @relation(fields: [userId], references: [id])
  userId            Int
  razorpayOrderId   String      @unique
  razorpayPaymentId String?     @unique
  razorpaySignature String?
  totalAmount       Float
  status            String      @default("PENDING")
  // Shipping Details
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  shippingAddress   String?
  city              String?
  state             String?
  pincode           String?
  createdAt         DateTime    @default(now())
  orderItems        OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int
  productId Int
  productName String
  quantity  Int
  price     Float
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Float
  image       String
  category    String
  inStock     Boolean @default(true)
}
